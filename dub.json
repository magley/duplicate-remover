{
	"name": "duplicate_remover",
	"authors": ["magley"],
	"copyright": "Copyright © 2025, magley",
	"targetType": "executable",
	"targetPath": "./bin/",
	"description": "Program for removing duplicate files.",
	"license": "BSD-2-Clause",
	"dependencies": {
		"xxhash3": "~>1.0.1"
	},
	"configurations": [
		{
			"name": "cli",
			"versions": ["cli"],
			"targetName": "duplicate_remover_cli",
			"sourcePaths": [
				"source/cli",
				"source/common",
				"source/vendor/clyd/"
			]
		},
		{
			"name": "gui",
			"versions": ["gui"],
			"targetName": "duplicate_remover_gui",
			"sourcePaths": [
				"source/gui",
				"source/common",
				"source/vendor/iup/",
				"source/vendor/cd/"
			],
			"libs": [
				"lib/cd",
				"lib/cdim",
				"lib/cdcontextplus",
				"lib/freetype",
				"lib/iup",
				"lib/iupcd",
				"lib/iupgl",
				"lib/iupimglib",
				"lib/iup_scintilla",
				"lib/iupcontrols",
				"user32",
				"gdi32",
				"comctl32",
				"comdlg32",
				"ole32",
				"oleaut32",
				"advapi32",
				"shell32",
				"imm32"
			]
		}
	]
}