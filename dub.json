{
	"name": "duplicate_remover",
	"authors": ["magley"],
	"copyright": "Copyright © 2025, magley",
	"targetType": "executable",
	"targetPath": "./bin/",
	"description": "Program for removing duplicate files.",
	"license": "BSD-2-Clause",
	"dependencies": {
		"xxhash3": "~>1.0.1"
	},
	"configurations": [
		{
			"name": "cli",
			"versions": ["cli"],
			"targetName": "duplicate_remover_cli",
			"mainSourceFile": "source/cli/main.d",
			"sourcePaths": [
				"source/cli",
				"source/common",
				"source/vendor/clyd/"
			]
		},
		{
			"name": "gui-windows",
			"versions": ["gui"],
			"targetName": "duplicate_remover_gui",
			"mainSourceFile": "source/gui/main.d",
			"sourcePaths": [
				"source/gui",
				"source/common",
				"source/vendor/iup/",
				"source/vendor/cd/"
			],
			"platforms": ["windows"],
			"libs": [
				"lib/windows/cd",
				"lib/windows/cdim",
				"lib/windows/cdcontextplus",
				"lib/windows/freetype",
				"lib/windows/iup",
				"lib/windows/iupcd",
				"lib/windows/iupgl",
				"lib/windows/iupimglib",
				"lib/windows/iup_scintilla",
				"lib/windows/iupcontrols",
				"user32",
				"gdi32",
				"comctl32",
				"comdlg32",
				"ole32",
				"oleaut32",
				"advapi32",
				"shell32",
				"imm32"
			] 
		},
		{
			"name": "gui-linux",
			"versions": ["gui"],
			"targetName": "duplicate_remover_gui",
			"mainSourceFile": "source/gui/main.d",
			"sourcePaths": [
				"source/gui",
				"source/common",
				"source/vendor/iup/",
				"source/vendor/cd/"
			],
			"platforms": ["linux"],
			"lflags": ["-Llib/linux"],
			"libs": [
				"cd",
				"cdim",
				"cdcontextplus",
				"iup",
				"iupcd",
				"iupgl",
				"iupimglib",
				"iup_scintilla",
				"iupcontrols",
				"im"
			]
		}
	]
}